{
  "name": "tt",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
      "onFail": "error"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint pi-worker/extensions test",
    "format": "oxfmt pi-worker/extensions test",
    "format:check": "oxfmt --check pi-worker/extensions test",
    "test": "node --test test/*.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  }
}
